rules_version = '2';

// Whossy Storage rules. NOT YET DEPLOYED; see firestore.rules for the same
// caveats.
//
// A getDownloadURL() link carries its own access token and is not subject
// to these rules. Anything whose URL is stored where other users can read
// it is therefore reachable by them, whatever `read` says below.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // `request.resource` is null on a delete.
    function isImageUpload() {
      return request.resource == null
        || (request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'));
    }

    match /users/{uid}/profile_pictures/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isImageUpload();
    }

    // Verification selfies: biometric, owner only.
    match /users/{uid}/face_verification/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isImageUpload();
    }

    match /users/{uid}/chat_images/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isImageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
