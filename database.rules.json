{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "presence": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "lastSeen": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
